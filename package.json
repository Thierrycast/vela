{
  "name": "vela",
  "version": "0.2.0",
  "private": true,
  "description": "Agente de navegador para Chrome: lê a página como texto, navega, clica, digita e conversa por voz — no seu navegador, com o seu provedor de IA.",
  "license": "MIT",
  "author": "Thierry Castro",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thierrycast/vela.git"
  },
  "keywords": [
    "chrome-extension",
    "browser-agent",
    "mv3",
    "llm",
    "voice",
    "automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "harness": "vite build --config tools/vite.harness.config.ts && node tools/out/harness.mjs",
    "ui": "vite --config vite.preview.config.ts",
    "bridge": "node bridge/vela-bridge.mjs",
    "drive": "node tools/drive.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
